# Committed dev config for the LOCAL EMULATOR (Vite dev mode / `npm run dev`).
# All values are public/non-secret (Firebase web config is public by design);
# for emulator use the API key just needs to be non-empty. VITE_USE_EMULATORS
# makes the app talk to the local Auth/Firestore/Functions emulators instead of
# a real project. Production build config is in web/.env.production.
VITE_FIREBASE_API_KEY=demo-emulator-key
VITE_FIREBASE_AUTH_DOMAIN=demo-obc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-obc
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FUNCTIONS_REGION=australia-southeast1
VITE_USE_EMULATORS=true
