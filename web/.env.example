# Copy to .env(.local) for local development. Only VITE_-prefixed values are
# ever bundled into the client — never put a secret in here (plan §14.1: no
# secrets in the web bundle).
#
# For local dev against the emulators, VITE_USE_EMULATORS=true and project id
# "demo-obc" with any non-empty API key work fine — the emulator does not
# validate them.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-obc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-obc
VITE_FIREBASE_APP_ID=demo-app-id
# Required by `firebase/messaging` (web push) even though it's not used for
# anything else here — the modular SDK needs it to talk to FCM. Public value,
# not a secret: Firebase console → Project settings → General → "Project
# number"/"Sender ID" (also shown on the Cloud Messaging tab). Any non-empty
# value works against the emulator.
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# The Web Push "VAPID key pair" public key (plan Phase 5b). Firebase console →
# Project settings → Cloud Messaging → "Web configuration" → Web Push
# certificates → generate a key pair if none exists, then copy the "Key
# pair" value here. Public value, not a secret — but push cannot actually be
# tested against the emulator (there is no FCM emulator); see
# docs/web-push.md. Leave blank for local dev against demo-obc.
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FUNCTIONS_REGION=australia-southeast1
VITE_USE_EMULATORS=true
