# Dependencies
node_modules/
.pnp
.pnp.js

# Build output. Scoped to the compiled-output directories only — a bare
# `lib/` would also match `firebase/functions/src/lib/`, which is source.
dist/
build/
firebase/functions/lib/
*.tsbuildinfo
.tsbuildinfo

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
*-debug.log
.runtimeconfig.json
firebase/functions/.env
firebase/functions/.env.*
!firebase/functions/.env.example
firebase/functions/.secret.local

# Emulator data
emulator-data/
firebase-export-*/

# Secrets / local config
.env
.env.local
.env.*.local
serviceAccountKey*.json
*-firebase-adminsdk-*.json
*service-account*.json
.firebaserc.local

# The real project ids live only in the (gitignored) copy of this file;
# `.firebaserc.example` (committed, placeholder projects) is unaffected.
firebase/.firebaserc

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test / coverage
coverage/
.nyc_output/
web/test-results/
web/playwright-report/
web/blob-report/
web/playwright/.cache/
/firebase-emulators.out
/web-dev.out

# Generated copy of shared/templates/members.csv — regenerated by
# `web/scripts/copy-templates.mjs` (predev/prebuild/pretest hooks); never
# hand-edit, and `src/lib/templates.test.ts` guards against drift.
web/public/templates/members.csv

# iOS
ios/**/Pods/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/GoogleService-Info.plist
ios/**/DerivedData/

# Hosting staging copy of web/dist (built by the hosting predeploy hook)
firebase/web-dist/

# Bundled functions deploy directory (built by functions/scripts/bundle.mjs)
firebase/functions-deploy/

# Committed emulator config (non-secret) — see the file header
!firebase/functions/.env.demo-obc
