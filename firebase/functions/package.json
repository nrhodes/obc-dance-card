{
  "name": "@obc/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "test": "vitest run",
    "test:rules": "firebase --project demo-obc emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:emu": "firebase --project demo-obc emulators:exec --only firestore,auth \"vitest run --config vitest.emu.config.ts\"",
    "seed": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} GCLOUD_PROJECT=${GCLOUD_PROJECT:-demo-obc} tsx ../seed/seed.ts",
    "lint": "eslint src",
    "bundle": "npm run build && node scripts/bundle.mjs"
  },
  "dependencies": {
    "@obc/shared": "*",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.2.0",
    "nodemailer": "^9.0.6",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.3.15",
    "esbuild": "^0.28.2",
    "firebase": "^12.18.0",
    "firebase-functions-test": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
