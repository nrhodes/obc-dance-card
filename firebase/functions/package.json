{
  "name": "@obc/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "test": "vitest run",
    "test:rules": "firebase --project demo-obc emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "seed": "node --loader ts-node/esm ./seed/seed.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@obc/shared": "*",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^20.17.10",
    "firebase": "^11.1.0",
    "firebase-functions-test": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
