# Committed, non-secret config for the LOCAL EMULATOR (project demo-obc).
# Loaded by the functions emulator so its params never prompt (which hangs a
# non-interactive CI run) and behaviour is deterministic on a fresh clone.
# Secrets are NOT here — they go in .secret.local (gitignored). Production
# config lives in .env.obc-dance-card.
ENFORCE_APP_CHECK=false
EMAIL_PROVIDER=console
EMAIL_FROM="Orewa Bridge Club <no-reply@example.org>"
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
WEB_APP_BASE_URL=http://localhost:5173
