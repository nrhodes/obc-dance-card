# Copy to .env for local development. Real values live in Firebase Secrets /
# environment config in deployed environments, never in the repo.
#
# Secrets declared with `defineSecret()` (LOGIN_CODE_PEPPER, SMTP_PASS,
# EMAIL_PROVIDER_KEY — see src/lib/secrets.ts) are NOT read from this file or
# from `.env`. For local emulator runs, put their values in
# `firebase/functions/.secret.local` (gitignored, one KEY=value per line,
# e.g. `LOGIN_CODE_PEPPER=some-long-random-local-value`) — the Firebase CLI
# and emulator suite read that file automatically. Never commit real values.

# App Check enforcement on callables + Firestore (plan §8.3). The emulator
# does not mint App Check tokens by default, so keep this false locally;
# production deploys set it true.
ENFORCE_APP_CHECK=false

# Transactional email (Phase 1+). Leave PROVIDER=console to print emails to the
# emulator log instead of sending.
EMAIL_PROVIDER=console
EMAIL_FROM="Orewa Bridge Club <no-reply@example.org>"
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Login codes
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# Public base URL of the web app, used in emails.
WEB_APP_BASE_URL=http://localhost:5173

# Address printed in visitor courtesy emails (plan §12.4) so a visitor can ask
# for their details to be removed.
CLUB_CONTACT_EMAIL=info@orewabridgeclub.org.nz
