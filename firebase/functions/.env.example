# Copy to .env for local development. Real values live in Firebase Secrets /
# environment config in deployed environments, never in the repo.
#
# Secrets declared with `defineSecret()` (LOGIN_CODE_PEPPER, SMTP_PASS,
# EMAIL_PROVIDER_KEY — see src/lib/secrets.ts) are NOT read from this file or
# from `.env`. For local emulator runs, put their values in
# `firebase/functions/.secret.local` (gitignored, one KEY=value per line,
# e.g. `LOGIN_CODE_PEPPER=some-long-random-local-value`) — the Firebase CLI
# and emulator suite read that file automatically. Never commit real values.

# App Check enforcement on callables + Firestore (plan §8.3, §18), declared as
# a Firebase param (`defineBoolean`, src/lib/callable.ts) so `firebase deploy`
# treats it as a first-class per-project setting rather than an ad-hoc env
# var. The emulator does not mint App Check tokens by default, so keep this
# false locally (this file, read for `npm run emulators` / `.env`/`.env.local`).
# Production deploys set `ENFORCE_APP_CHECK=true` in
# `firebase/functions/.env.<projectId>` (e.g. `.env.obc-dance-card`,
# `.env.obc-dance-card-dev`) — NOT in this shared `.env.example`/`.env` file,
# so dev/emulator behaviour is never accidentally affected by a prod setting.
# See docs/security-checklist.md for the App Check row.
ENFORCE_APP_CHECK=false

# Transactional email (Phase 1+). Leave EMAIL_PROVIDER=console to print emails
# to the emulator log (and write them to `emulatorOutbox`) instead of sending;
# set to `smtp` for the Google Workspace relay (plan §19) once SMTP_HOST/
# SMTP_USER/SMTP_PASS are configured. EMAIL_FROM is the From: header used by
# every outgoing email (login codes, notifications, digests, visitor courtesy
# emails).
EMAIL_PROVIDER=console
EMAIL_FROM="Orewa Bridge Club <no-reply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=

# Login codes
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# Public base URL of the web app, used in emails and to construct iCal feed
# subscription URLs (plan §21 B1, `ical/tokens.ts`).
WEB_APP_BASE_URL=http://localhost:5173

# Address printed in visitor courtesy emails (plan §12.4) so a visitor can ask
# for their details to be removed.
CLUB_CONTACT_EMAIL=info@orewabridgeclub.org.nz

# Push (FCM) has no config here: `notifications/dispatch.ts` selects a real
# FCM send only on a deployed Cloud Function (`isDeployed()`, see
# `email/provider.ts`); everywhere else — emulator, `vitest`, local scripts —
# it is a no-op that records to `emulatorOutbox` instead, same as the console
# email provider.
