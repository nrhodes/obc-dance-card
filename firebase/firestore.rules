rules_version = '2';

// OBC Dance Card — Firestore security rules.
//
// Model summary (plan §10):
//  * Clients never write Firestore, with exactly one exception: a member may
//    flip `read`/`readAt` on their own `notifications` doc. Every other
//    mutation is a Cloud Function callable using the Admin SDK, which bypasses
//    these rules and carries its own authorisation logic (plan §9).
//  * "Active member" / "admin" are determined by reading the caller's own
//    `members/{uid}` document with `get()` — never from custom claims/token
//    data, so a deactivation or role change takes effect on the caller's very
//    next request instead of waiting for a token refresh.

service cloud.firestore {
  match /databases/{database}/documents {

    /* --------------------------- helpers --------------------------- */

    function callerDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isActiveMember() {
      return request.auth != null && callerDoc().active == true;
    }

    function isAdmin() {
      return isActiveMember() && callerDoc().role == 'admin';
    }

    function isSelf(id) {
      return request.auth != null && request.auth.uid == id;
    }

    function programmePublished(year) {
      return get(/databases/$(database)/documents/programmes/$(year)).data.status == 'published';
    }

    /* --------------------------- members --------------------------- */

    match /members/{id} {
      // The printed booklet lists every member's name and phone; mirror that —
      // any active member may read any other *active* member, and always
      // their own doc (even if it has just been deactivated).
      allow read: if isAdmin() || (isActiveMember() && (resource.data.active == true || isSelf(id)));
      allow write: if false; // provisioning, imports, role/active changes: functions only.
    }

    /* ------------------------ memberPrivate -------------------------- */

    match /memberPrivate/{id} {
      allow read: if (isSelf(id) && isActiveMember()) || isAdmin();
      allow write: if false;
    }

    /* --------------------------- visitors ----------------------------- */

    match /visitors/{id} {
      allow read: if isAdmin() || (isActiveMember() && resource.data.createdByMemberId == request.auth.uid);
      allow write: if false;
    }

    /* ------------------------- programmes -------------------------- */

    match /programmes/{year} {
      allow read: if isAdmin() || (isActiveMember() && resource.data.status == 'published');
      allow write: if false;

      // weekdays/{id}, series/{id}, sessions/{id} — gated on the parent
      // programme's publish status for non-admins.
      match /{sub}/{id} {
        allow read: if isAdmin() || (isActiveMember() && programmePublished(year));
        allow write: if false;
      }
    }

    /* --------------------------- entries -------------------------- */

    match /entries/{id} {
      // Roster visibility: any active member can see who is playing / looking.
      // Every write — solo status, pairing, substitute, cancel, team roster —
      // goes through a callable so pairing/team invariants can be enforced
      // transactionally (plan §7).
      allow read: if isActiveMember();
      allow write: if false;
    }

    /* ---------------------------- teams ------------------------------ */

    match /teams/{id} {
      // Roster parity: the booklet would list team members.
      allow read: if isActiveMember();
      allow write: if false;
    }

    /* --------------------------- invites -------------------------- */

    match /invites/{id} {
      // Written as two equalities (not `uid in [a, b]`): for *queries* the
      // rules engine must prove the rule from the query's own filters, and it
      // can do that for `toMemberId == uid` / `fromMemberId == uid` but not
      // for list membership — the `in` form silently denied the inbox query.
      allow read: if isAdmin()
        || (isActiveMember()
            && (resource.data.toMemberId == request.auth.uid
                || resource.data.fromMemberId == request.auth.uid));
      allow write: if false; // sending / responding / cancelling all go through callables.
    }

    /* ------------------------ notifications ---------------------- */

    match /notifications/{id} {
      allow read: if isActiveMember() && resource.data.memberId == request.auth.uid;

      // The one exception to "no client writes": the owner may toggle their
      // own read flag, and nothing else.
      allow update: if isActiveMember()
        && resource.data.memberId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read is bool;

      allow create, delete: if false;
    }

    /* ------------------- server-only collections ---------------- */

    // Admins read the audit log through the paged `listAuditLog` callable, not
    // directly, to keep the rules surface minimal.
    match /auditLog/{id} { allow read, write: if false; }
    match /emailCodes/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /imports/{id} { allow read, write: if false; }
    // iCal feed token lookup (plan §21 B1) — read only by the `icalFeed`
    // HTTP endpoint (Admin SDK, bypasses rules) via `sha256hex(token)`.
    // Never client-readable, even by the owner or an admin: the whole point
    // is that a calendar client authorises with the token itself, not with
    // a Firebase session. The owner's plaintext copy (for redisplay) lives
    // on `memberPrivate`, already covered by that collection's rule above.
    match /icalTokens/{id} { allow read, write: if false; }
    // Nightly/admin integrity sweep runs (plan §16 Phase 6) — read only through
    // logs/`runPairingSweep`'s return value, never directly.
    match /integrity/{id} { allow read, write: if false; }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
