rules_version = '2';

// OBC Dance Card — Firestore security rules.
//
// Model summary:
//  * Every signed-in user has a `members/{uid}` document (id == auth uid),
//    provisioned by a Cloud Function from the admin-loaded allowlist on first
//    sign-in. Custom claims `role` ("member" | "admin") and `active` (bool)
//    mirror that document so most checks avoid an extra read.
//  * Clients may only ever touch their OWN solo entry (looking_for_partner /
//    available / cancel-while-solo) and a whitelisted slice of their own member
//    doc. Anything that pairs two members, imports data, or acts on behalf of
//    someone runs in a Cloud Function with the Admin SDK, which bypasses rules.

service cloud.firestore {
  match /databases/{database}/documents {

    /* --------------------------- helpers --------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isActiveMember() {
      return isSignedIn() && claims().get('active', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && claims().get('role', 'member') == 'admin';
    }

    // Fields a member is allowed to change on their own member document.
    function memberSelfWritableOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['phone', 'notificationPrefs', 'devices', 'updatedAt']);
    }

    // A brand-new entry the caller is allowed to self-create: their own, solo,
    // publicly advertising availability. No partner, no pairing.
    function isSelfSoloCreate() {
      let d = request.resource.data;
      return d.memberId == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.partnerMemberId == null
        && d.pairingId == null
        && d.get('substituteMemberId', null) == null
        && d.get('isSubstituteFor', null) == null
        && d.status in ['looking_for_partner', 'available'];
    }

    // A self-update the caller may make to their own entry: tweak the note, swap
    // between the two solo statuses, or cancel — but only while it is still solo
    // (an unpaired entry). Paired entries can only be changed by a function.
    function isSelfSoloUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.memberId == request.auth.uid
        && before.partnerMemberId == null
        && before.pairingId == null
        && after.memberId == before.memberId
        && after.partnerMemberId == null
        && after.pairingId == null
        && after.status in ['looking_for_partner', 'available', 'cancelled']
        && after.diff(before).affectedKeys().hasOnly(['status', 'note', 'updatedAt']);
    }

    /* --------------------------- members --------------------------- */

    match /members/{memberId} {
      // The printed booklet lists every member's name and phone; mirror that —
      // any active member may read any member.
      allow read: if isActiveMember();

      allow update: if isAdmin()
        || (request.auth.uid == memberId && isActiveMember() && memberSelfWritableOnly());

      // Provisioning, imports, deactivation, role changes: functions only.
      allow create, delete: if false;
    }

    /* ------------------------- programmes -------------------------- */

    match /programmes/{year} {
      allow read: if isAdmin()
        || (isActiveMember() && resource.data.status == 'published');
      allow write: if isAdmin();

      match /weekdays/{weekday} {
        allow read: if isAdmin() || isActiveMember();
        allow write: if isAdmin();
      }
      match /series/{seriesId} {
        allow read: if isAdmin() || isActiveMember();
        allow write: if isAdmin();
      }
      match /sessions/{sessionId} {
        allow read: if isAdmin() || isActiveMember();
        allow write: if isAdmin();
      }
    }

    /* --------------------------- entries -------------------------- */

    match /entries/{entryId} {
      // Roster visibility: any active member can see who is playing / looking.
      allow read: if isActiveMember();

      allow create: if isActiveMember() && isSelfSoloCreate();
      allow update: if isActiveMember() && isSelfSoloUpdate();

      // Paired create/update, substitutes, on-behalf, and all deletes: functions.
      allow delete: if false;
    }

    /* --------------------------- invites -------------------------- */

    match /invites/{inviteId} {
      allow read: if isAdmin()
        || (isActiveMember()
            && request.auth.uid in [resource.data.fromMemberId, resource.data.toMemberId]);

      // Sending / responding / cancelling all go through callables.
      allow write: if false;
    }

    /* ------------------------ notifications ---------------------- */

    match /notifications/{notificationId} {
      allow read: if isActiveMember() && request.auth.uid == resource.data.memberId;

      // Only the "read" flag may be toggled by the owner.
      allow update: if isActiveMember()
        && request.auth.uid == resource.data.memberId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read', 'readAt']);

      allow create, delete: if false;
    }

    /* -------------------------- audit log ----------------------- */

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ------------------- server-only collections ---------------- */

    match /emailCodes/{codeId} {
      allow read, write: if false;
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
